+static void drm_free_logical_buffers(drm_dev_t * drm_dev)
+{
+    for(int i = 0; i < BUFFER_CNT; ++i) {
+        free(drm_dev->logical_raw[i]);
+        drm_dev->logical_raw[i] = NULL;
+        drm_dev->logical_bufs[i] = NULL;
+    }
+    drm_dev->logical_buf_size = 0;
+}
+
+static uint8_t * drm_alloc_aligned(size_t size, void ** raw_out)
+{
+    size_t align = LV_DRAW_BUF_ALIGN;
+    if(align < sizeof(void *)) align = sizeof(void *);
+    void * raw = malloc(size + align);
+    if(!raw) {
+        *raw_out = NULL;
+        return NULL;
+    }
+    uintptr_t aligned = ((uintptr_t)raw + (align - 1u)) & ~((uintptr_t)align - 1u);
+    *raw_out = raw;
+    return (uint8_t *)aligned;
+}
+
+/* Rotation 0 draws straight into the dumb buffers. Any other rotation draws the
+ * logical frame into system memory (outside LVGL's pool) and drm_flush rotates
+ * that frame into the scanout buffer. */
+static void drm_configure_draw_buffers(lv_display_t * disp, drm_dev_t * drm_dev)
+{
+    if(!drm_dev || drm_dev->fd < 0 || !drm_dev->drm_bufs[0].map || drm_dev->drm_bufs[0].map == MAP_FAILED) {
+        return;
+    }
+
+    if(lv_display_get_rotation(disp) == LV_DISPLAY_ROTATION_0) {
+        drm_free_logical_buffers(drm_dev);
+        size_t buf_size = LV_MIN(drm_dev->drm_bufs[1].size, drm_dev->drm_bufs[0].size);
+        uint32_t stride = drm_dev->drm_bufs[0].pitch;
+        lv_display_set_buffers_with_stride(disp, drm_dev->drm_bufs[1].map, drm_dev->drm_bufs[0].map,
+                                           (uint32_t)buf_size, stride, LV_DISPLAY_RENDER_MODE_DIRECT);
+        return;
+    }
+
+    const int32_t logical_w = lv_display_get_horizontal_resolution(disp);
+    const int32_t logical_h = lv_display_get_vertical_resolution(disp);
+    const int32_t original_h = lv_display_get_original_vertical_resolution(disp);
+    if(logical_w <= 0 || logical_h <= 0 || original_h <= 0) {
+        return;
+    }
+
+    const lv_color_format_t cf = lv_display_get_color_format(disp);
+    const uint32_t logical_stride = lv_draw_buf_width_to_stride((uint32_t)logical_w, cf);
+    const int32_t guard_h = logical_h > original_h ? logical_h : original_h;
+    const uint64_t bytes = (uint64_t)logical_stride * (uint64_t)guard_h;
+    if(logical_stride == 0 || bytes == 0 || bytes > UINT32_MAX) {
+        LV_LOG_ERROR("DRM rotation buffer size is invalid");
+        return;
+    }
+
+    if(drm_dev->logical_buf_size != (size_t)bytes || !drm_dev->logical_bufs[0] || !drm_dev->logical_bufs[1]) {
+        drm_free_logical_buffers(drm_dev);
+        for(int i = 0; i < BUFFER_CNT; ++i) {
+            drm_dev->logical_bufs[i] = drm_alloc_aligned((size_t)bytes, &drm_dev->logical_raw[i]);
+            if(!drm_dev->logical_bufs[i]) {
+                LV_LOG_ERROR("DRM rotation buffer allocation failed");
+                drm_free_logical_buffers(drm_dev);
+                return;
+            }
+            lv_memzero(drm_dev->logical_bufs[i], (size_t)bytes);
+        }
+        drm_dev->logical_buf_size = (size_t)bytes;
+    }
+
+    /* set_buffers sizes the draw buffer from the unrotated resolution, so the
+     * allocation covers stride * max(logical, original) height. Refresh reshapes
+     * the header to the logical size, which still fits. */
+    lv_display_set_buffers_with_stride(disp, drm_dev->logical_bufs[1], drm_dev->logical_bufs[0],
+                                       (uint32_t)bytes, logical_stride, LV_DISPLAY_RENDER_MODE_DIRECT);
+}
+
+static void drm_resolution_event_cb(lv_event_t * event)
+{
+    if(lv_event_get_code(event) != LV_EVENT_RESOLUTION_CHANGED) return;
+    lv_display_t * disp = lv_event_get_target(event);
+    drm_dev_t * drm_dev = lv_display_get_driver_data(disp);
+    drm_configure_draw_buffers(disp, drm_dev);
+}
+
+static size_t drm_select_mode_index(drm_dev_t * drm_dev, drmModeConnector * conn)
+{
+    if(!drm_dev->mode_select_cb || !drm_dev->disp || conn->count_modes <= 0) {
+        return 0;
+    }
+
+    lv_linux_drm_mode_t * modes = lv_malloc(sizeof(lv_linux_drm_mode_t) * (size_t)conn->count_modes);
+    if(!modes) {
+        LV_LOG_WARN("Failed to allocate memory for drm modes");
+        return 0;
+    }
+    for(int i = 0; i < conn->count_modes; i++) {
+        modes[i].mode_info = &conn->modes[i];
+    }
+    size_t mode_index = drm_dev->mode_select_cb(drm_dev->disp, modes, (size_t)conn->count_modes);
+    lv_free(modes);
+    if(mode_index >= (size_t)conn->count_modes) {
+        LV_LOG_WARN("DRM mode callback returned an out of range index; using mode 0");
+        return 0;
+    }
+    return mode_index;
+}
